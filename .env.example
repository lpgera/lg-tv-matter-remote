# IP address of the TV (give it a DHCP reservation)
TV_HOST=192.168.1.50
# MAC address of the TV's network interface, used for Wake-on-LAN
TV_MAC=aa:bb:cc:dd:ee:ff
# Optional: broadcast address for Wake-on-LAN packets
# TV_WOL_ADDRESS=192.168.1.255
# Optional: picture setting used for brightness, auto-detected (backlight / oledLight)
# TV_BRIGHTNESS_KEY=backlight

# Optional Matter settings
# MATTER_PORT=5540
# MATTER_PASSCODE=20202021
# MATTER_DISCRIMINATOR=3840

MATTER_LOG_LEVEL=info

# Optional: where the TV client key and Matter fabric data are stored
# DATA_DIR=./data
